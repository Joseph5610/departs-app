{
    "compilerOptions": {
        "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.functions.tsbuildinfo",
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": [
            "esnext"
        ],
        "types": [
            "@cloudflare/workers-types"
        ],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "**/*.ts"
    ]
}