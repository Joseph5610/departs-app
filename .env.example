# Cloudflare Turnstile Site Key (Frontend widget)
# Get yours at https://dash.cloudflare.com/ -> Turnstile
# Required for production builds: without it the feedback and crash-report forms show as unavailable.
# `npm run dev` falls back to Cloudflare's always-pass test key when this is unset.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
